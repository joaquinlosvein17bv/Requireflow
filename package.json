{
  "name": "requireflow",
  "version": "0.1.0",
  "description": "Local-first Backlog, Task & Bugfix Lifecycle Engine with Embedded Vanilla Dashboard and Agentic MCP Protocol",
  "bin": {
    "requireflow": "./bin/requireflow.ts"
  },
  "type": "module",
  "scripts": {
